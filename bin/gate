#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"

usage() {
    cat <<'EOF'
Run the checks a change must pass.

Usage: bin/gate [--fast]

Options:
      --fast  fmt, clippy, the tests without the model and the doc tests
  -h, --help  Print help

Without --fast it runs the full gate: the same with --locked, the search
example in release, which fetches the model when the folder lacks it, then
the tests with the model; it needs PITO_EMBED_MODELS set to the model folder.

With CARGO_NET_OFFLINE set to 1 or true it first fetches ONNX Runtime into
ort-sys's cache with the workspace's ort-cache tool, then runs cargo with
--offline instead.
EOF
}

refuse() {
    local bold='' red='' yellow='' under='' reset=''
    if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
        bold=$'\e[1m' red=$'\e[1;31m' yellow=$'\e[33m' under=$'\e[1;4m' reset=$'\e[0m'
    fi
    {
        if [ "$2" = repeated ]; then
            printf "%serror:%s the argument '%s%s%s' cannot be used multiple times\n" "$red" "$reset" "$yellow" "$1" "$reset"
        else
            printf "%serror:%s unexpected argument '%s%s%s' found\n" "$red" "$reset" "$yellow" "$1" "$reset"
        fi
        printf '\n'
        printf '%sUsage:%s %sbin/gate%s [--fast]\n' "$under" "$reset" "$bold" "$reset"
        printf '\n'
        printf "For more information, try '%s--help%s'.\n" "$bold" "$reset"
    } >&2
    exit 2
}

fast=0
for arg in "$@"; do
    case "$arg" in
        -h | --help)
            usage
            exit 0
            ;;
        --fast)
            [ "$fast" -eq 0 ] || refuse "$arg" repeated
            fast=1
            ;;
        *)
            refuse "$arg" unexpected
            ;;
    esac
done

if [ "$fast" -eq 0 ] && [ -z "${PITO_EMBED_MODELS:-}" ]; then
    echo "bin/gate: the full gate needs PITO_EMBED_MODELS set to the model folder" >&2
    exit 1
fi

offline=0
off=''
case "$(printf '%s' "${CARGO_NET_OFFLINE:-}" | tr '[:upper:]' '[:lower:]')" in
    1 | true) offline=1 ;;
esac
if [ "$offline" -eq 1 ]; then
    cargo run -q --locked --offline -p ort-cache --
    off=--offline
fi

step() {
    if [ "$offline" -eq 1 ]; then
        env -u CARGO_NET_OFFLINE "$@"
    else
        "$@"
    fi
}

if [ "$fast" -eq 1 ]; then
    cargo fmt --all --check
    step cargo clippy $off --workspace --all-targets -- -D warnings
    step env -u PITO_EMBED_MODELS cargo nextest run $off --workspace --no-tests=pass
    step cargo test $off --workspace --doc
    echo "fast gate: green"
    exit 0
fi

cargo fmt --all --check
step cargo clippy $off --workspace --all-targets --locked -- -D warnings
step cargo test $off --workspace --doc --locked
step cargo run $off --release --locked --example search -- a hidden area
step cargo nextest run $off --workspace --locked --no-tests=pass
echo "gate: green"
